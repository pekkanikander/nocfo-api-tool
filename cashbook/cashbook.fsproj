<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="rules-template.toml" LogicalName="rules-template.toml" />
    <Compile Include="Seed.fs" />
    <Compile Include="TomlReader.fs" />
    <Compile Include="Rules.fs" />
    <Compile Include="CsvReader.fs" />
    <Compile Include="Period.fs" />
    <Compile Include="CashBook.fs" />
    <Compile Include="MobilePay.fs" />
    <Compile Include="Matching.fs" />
    <Compile Include="Classification.fs" />
    <Compile Include="Plan.fs" />
    <Compile Include="Reports.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>
</Project>
