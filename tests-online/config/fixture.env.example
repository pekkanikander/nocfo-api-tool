# Replace this with a stable slug from the api-tst environment.
TEST_BUSINESS_SLUG=replace-me-with-api-tst-business-slug

# Replace this with a stable account id from the api-tst business above.
# Used by mutation tests to verify round-trip updates. The account's number is
# temporarily changed to 9999 and then restored, so no other account in the
# business may use that number.
TEST_ACCOUNT_ID=replace-me-with-stable-account-id

# An account number with entries in the business above, and a date range that
# covers at least one of them. Used by the balance and reconcile cases.
TEST_LEDGER_ACCOUNT=replace-me-with-account-number
TEST_LEDGER_FROM=2025-01-01
TEST_LEDGER_TO=2025-03-31
