{
  "rest-client.environmentVariables": {
    "$shared": {
      "version": "v1"
    },
    "local": {
      "baseUrl": "http://127.0.0.1:4010",
    },
    "proxy": {
        "baseUrl": "http://127.0.0.1:4011",
      },
